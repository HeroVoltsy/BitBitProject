# Public FastAPI address only. Never add database passwords or JWT/KYC keys here.
# Local development (run FastAPI separately):
VITE_API_BASE_URL=http://127.0.0.1:8000
# Deployment: set VITE_API_BASE_URL=https://bit-bit-project.vercel.app in Vercel.
# Vite embeds this at build time; rebuild after changing it.
VITE_MAP_PUBLIC_KEY=your_public_map_key_here
