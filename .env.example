APP_NAME="BiTBiT API"
DEBUG=false
DATABASE_URL=postgresql+asyncpg://bitbit_user:replace_with_local_password@127.0.0.1:5432/bitbit
JWT_SECRET_KEY=replace_with_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Install requirements, then run: python scripts/configure_kyc.py
# Run python -m alembic upgrade head, then restart the backend.
# Keep the key stable and private; a shared database requires the same key.
KYC_ENCRYPTION_KEY=
KYC_UPLOAD_DIR=var/kyc
